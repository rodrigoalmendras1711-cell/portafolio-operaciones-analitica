# IGNORAR BASES DE DATOS, DATOS CRUDOS Y SALIDAS (Protección ACHS)
data/*
staging/*
output/*
*.duckdb
*.duckdb.wal
*.db
*.pbix

# IGNORAR ARCHIVOS EXCEL Y DATOS EN CUALQUIER CARPETA
*.xlsx
*.xlsm
*.csv
*.parquet
*.json

# Excepciones: Mantener las carpetas vivas en GitHub usando .gitkeep
!data/.gitkeep
!staging/.gitkeep
!output/.gitkeep

# Entornos virtuales y Python
venv/
env/
.env
__pycache__/
*.pyc