# IGNORAR BASES DE DATOS, DATOS CRUDOS Y SALIDAS (Protección)
data/*
staging/*
output/*
*.duckdb
*.duckdb.wal
*.db
*.pbix

# IGNORAR ARCHIVOS EXCEL Y DATOS EN CUALQUIER CARPETA
*.xlsx
*.xlsm
*.csv
*.parquet
*.json

# -------------------------------------------------------------
# EXCEPCIONES: LO QUE SÍ DEBE SUBIR A GITHUB
# -------------------------------------------------------------
# Mantener las carpetas vivas en GitHub usando .gitkeep
!data/.gitkeep
!staging/.gitkeep
!output/.gitkeep

# PERMITIR CARPETA DE PORTAFOLIO Y SUS DATOS ANONIMIZADOS
!portfolio_data/
!portfolio_data/**
!portfolio_data/**/*.parquet
!portfolio_data/**/*.xlsx
!portfolio_data/**/*.csv

# -------------------------------------------------------------
# Entornos virtuales y Python
venv/
env/
.env
__pycache__/
*.pyc